      "provider_id": "32024R1689-en",
      "title": "Artificial Intelligence Act, English expression",
      "source_language": "en",
      "official_url": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689",
      "source_modified_at": "2024-07-12T00:00:00Z",
      "sections": [
        {
          "heading": "Article 1",
          "locator": {"kind": "article", "start": "1", "end": "1"},
          "text": "This Regulation lays down harmonised rules on artificial intelligence."
        }
      ]
    }
