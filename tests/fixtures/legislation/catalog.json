  "documents": [
    {
      "key": "dip:dokument:bt-20-1234",
      "source": "dip",
      "provider_id": "BT-20-1234",
      "title": "Gesetzentwurf zur digitalen Verwaltung",
      "source_language": "de",
      "official_url": "https://dip.bundestag.de/dokument/BT-20-1234",
      "source_modified_at": "2026-06-01T07:00:00Z",
      "sections": [
        {
          "heading": "§ 1 Zweck",
          "locator": {"kind": "paragraph", "start": "1", "end": "2"},
          "text": "Dieses Gesetz erleichtert digitale Verwaltungsleistungen. Es begründet keinen Anspruch auf eine vollständig automatisierte Entscheidung. Ausnahmen für besonders schutzbedürftige Daten bleiben unberührt."
        },
        {
          "heading": "§ 2 Inkrafttreten",
          "locator": {"kind": "paragraph", "start": "3", "end": "3"},
          "text": "Dieses Gesetz tritt am ersten Tag des folgenden Monats in Kraft."
        }
      ]
    },
    {
      "key": "cellar:file:32024R1689:en",
